  "cards": [
    {
      "dot": "cyan",
      "title": "Three workflows",
      "items": [
        "Student adviser: transcript/qualification explanation and school Q&A.",
        "Teaching assistant: curriculum retrieval, lesson drafts and submission.",
        "Operations assistant: classes, timetable, attendance/exam reports and Google Calendar appointments."
      ]
    },
    {
      "dot": "rose",
      "title": "Approval and execution",
      "items": [
        "Lesson publication follows HOD review, dean approval of every version, then teacher publication.",
        "Other changes require the operation's authorised approver; agent text never grants permission.",
        "Go rechecks current roles, resource scope, expected versions and conflicts after an approval resumes."
      ]
    },
    {
      "dot": "amber",
      "title": "Recovery and evidence",
      "items": [
        "LangGraph persists state before a human pause; restart resumes without repeating completed writes.",
        "Exact command keys and provider event IDs prevent duplicate calendar writes on retry.",
        "Untrusted document text cannot register tools, choose an approver or bypass a gate."
      ]
    }
  ]
