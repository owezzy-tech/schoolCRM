  "cards": [
    {
      "dot": "emerald",
      "title": "Curriculum scope",
      "items": [
        "Kenya CBC/CBE uses competency-based, student-centred lesson design; keep legacy 8-4-4 separate.",
        "Cambridge supports inquiry/project-based learning through Year 9; no automatic Kenyan grade/year equivalence.",
        "Actual curriculum files are still needed; a target curriculum description is not teaching content."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust and source identity",
      "items": [
        "Framework, stage/year, subject, topic, revision and access metadata travel with each source chunk.",
        "Unreviewed or withdrawn content never enters the active retrieval set.",
        "Blueprint/architecture proposals are excluded from both teaching and student evidence collections."
      ]
    },
    {
      "dot": "amber",
      "title": "Qualification boundary",
      "items": [
        "Existing admissions source graphs are historical and require evidence review.",
        "Go owns numerical evaluation; the current public KCSE cluster calculation is an estimate.",
        "Cambridge/CBC/8-4-4 qualification equivalence needs authoritative mapping, not model inference."
      ]
    }
  ]
