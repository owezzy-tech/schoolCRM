    {
      "dot": "cyan",
      "title": "Primary request path",
      "items": [
        "Staff browser → Angular Web Admin → Go SchoolCRM API → PostgreSQL",
        "The Web Admin also calls Auth Service for login and token lifecycle"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Auth Service owns identity and authorization policy decisions",
        "SchoolCRM API handlers return JSON:API documents",
        "PostgreSQL remains behind the application persistence boundary"
      ]
    },
    {
      "dot": "emerald",
      "title": "Supporting runtime detail",
      "items": [
        "Migration + Seed runs before the API against the same database",
        "RAG is a separate FastAPI bounded context with document and query endpoints",
        "Metrics consumes the SchoolCRM debug-vars endpoint for operational visibility"
      ]
    }
  ]
